# Bot Agent configuration (Python Telegram AI bot)
# Copy to .env and fill in values

# Telegram bot tokens (4 bots for sharding)
BOT_TOKEN_1=
BOT_TOKEN_2=
BOT_TOKEN_3=
BOT_TOKEN_4=

# Proxy for Telegram (VPS in Russia)
TELEGRAM_PROXY=

# Internal auth secret (must match CRM stack)
INTERNAL_SECRET=try-neuro-internal-secret-2026

# CRM backend URL (Docker internal)
CRM_BACKEND_URL=http://backend:8080

# PostgreSQL connection for user AI config lookups
DATABASE_URL=postgresql://postgres:PASSWORD@tryneuro_database:5432/tryneuro_db
