<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тема для запуска (Splash Screen) -->
    <!-- Используем стандартную Android тему без заголовка -->
    <style name="LaunchTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Основная тема приложения -->
    <!-- Она должна быть такой же по структуре, как LaunchTheme -->
    <style name="NormalTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
