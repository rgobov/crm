# Этап 1: Установка Flutter SDK и сборка приложения
FROM dart:stable AS build

RUN apt-get update && apt-get install -y git curl unzip

ARG FLUTTER_VERSION=3.24.0
RUN git clone https://github.com/flutter/flutter.git --depth 1 --branch ${FLUTTER_VERSION} /flutter
ENV PATH="/flutter/bin:${PATH}"

RUN flutter --version
RUN flutter config --enable-web

WORKDIR /app

COPY pubspec.yaml ./
RUN flutter pub get

COPY . .
# ИСПОЛЬЗУЕМ HTML RENDERER: это критично для клавиатуры в Telegram Mini App
RUN flutter build web --release --web-renderer html

# Этап 2: Настройка веб-сервера Nginx
FROM nginx:alpine

COPY --from=build /app/build/web /usr/share/nginx/html

# Копируем конфиг из корня проекта
COPY nginx-frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
