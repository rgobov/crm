{
  agents: {
    defaults: {
      workspace: "~/.openclaw/workspace-main"
    },
    list: [
      { id: "shard_1", workspace: "~/.openclaw/workspace-shard_1" },
      { id: "shard_2", workspace: "~/.openclaw/workspace-shard_2" },
      { id: "shard_3", workspace: "~/.openclaw/workspace-shard_3" },
      { id: "shard_4", workspace: "~/.openclaw/workspace-shard_4" }
    ]
  },
  bindings: [
    { agentId: "shard_1", match: { channel: "telegram", accountId: "shard_1" } },
    { agentId: "shard_2", match: { channel: "telegram", accountId: "shard_2" } },
    { agentId: "shard_3", match: { channel: "telegram", accountId: "shard_3" } },
    { agentId: "shard_4", match: { channel: "telegram", accountId: "shard_4" } }
  ],
  channels: {
    telegram: {
      enabled: true,
      dmPolicy: "allowlist",
      allowFrom: ["*"],
      accounts: {
        shard_1: { botToken: "${BOT_TOKEN_1}", dmPolicy: "allowlist", allowFrom: ["*"] },
        shard_2: { botToken: "${BOT_TOKEN_2}", dmPolicy: "allowlist", allowFrom: ["*"] },
        shard_3: { botToken: "${BOT_TOKEN_3}", dmPolicy: "allowlist", allowFrom: ["*"] },
        shard_4: { botToken: "${BOT_TOKEN_4}", dmPolicy: "allowlist", allowFrom: ["*"] }
      }
    }
  },
  mcp: {
    servers: {
      crm: {
        transport: "streamable-http",
        url: "http://mcp-crm:8000/mcp"
      }
    }
  },
  plugins: {
    entries: {
      "tryneuro-provider": {
        source: "./extensions/tryneuro-provider"
      }
    }
  }
}